name: looming
services:
    bundle-postgres:
        env_file:
            - /etc/looming/postgres.env
        image: postgres:16-alpine
        ports:
            - 5432:5432
        restart: unless-stopped
        volumes:
            - /var/lib/looming/postgres:/var/lib/postgresql/data
    gateway-front:
        build:
            context: gateway
        environment:
            GATEWAY_LISTEN: :8080
            GATEWAY_UPSTREAM: http://10.0.0.13:4000
        ports:
            - 8080:8080
        restart: unless-stopped
